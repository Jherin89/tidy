class Tidy < Formula
  desc "Rules-driven cleanup for a messy Downloads folder"
  homepage "https://github.com/Jherin89/tidy"
  license "MIT"

  # One universal (arm64 + x86_64) archive serves both Mac architectures.
  on_macos do
    on_arm do
      url "https://github.com/Jherin89/tidy/releases/download/v__VERSION__/tidy-__VERSION__-universal-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS__"
    end
    on_intel do
      url "https://github.com/Jherin89/tidy/releases/download/v__VERSION__/tidy-__VERSION__-universal-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS__"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/Jherin89/tidy/releases/download/v__VERSION__/tidy-__VERSION__-x86_64-unknown-linux-musl.tar.gz"
      sha256 "__SHA_LINUX_INTEL__"
    end
    on_arm do
      url "https://github.com/Jherin89/tidy/releases/download/v__VERSION__/tidy-__VERSION__-aarch64-unknown-linux-musl.tar.gz"
      sha256 "__SHA_LINUX_ARM__"
    end
  end

  conflicts_with "tidy-html5", because: "both install a `tidy` binary"

  def install
    bin.install "tidy"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tidy --version")
    inbox = testpath/"inbox"
    inbox.mkpath
    assert_match "Nothing to do", shell_output("#{bin}/tidy #{inbox}")
  end
end
